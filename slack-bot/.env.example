# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# All three come from https://api.slack.com/apps → your app. Create the app from
# slack-app-manifest.yaml so the scopes match what the code actually calls.

# Bot User OAuth Token, "OAuth & Permissions" page. Starts xoxb-
# [ต้องใส่ — บอทเริ่มไม่ได้ถ้าไม่มี]
SLACK_BOT_TOKEN=

# App-Level Token with connections:write, "Basic Information" → App-Level Tokens.
# Starts xapp-. Socket Mode needs this; without it the app cannot open a socket.
# [ต้องใส่ — Socket Mode เปิดไม่ได้ถ้าไม่มี]
SLACK_APP_TOKEN=

# "Basic Information" → App Credentials → Signing Secret.
# [ต้องใส่ — บอทเริ่มไม่ได้ถ้าไม่มี]
SLACK_SIGNING_SECRET=

# Where the daily digest is posted. Channel ID, not name — the bot must be a
# member. Find it under View channel details → About, e.g. C0DEMOCHAN1
# [ไม่ต้องใส่ — แต่ถ้าไม่ใส่ digest ตามเวลาจะไม่โพสต์ที่ไหน และ allowlist จะแคบลง]
DIGEST_CHANNEL=

# Comma-separated channel IDs for scripts/export-slack.ts, e.g. C0DEMOCHAN1,C0ABC123
# [ไม่ต้องใส่ — ใช้เฉพาะ scripts/export-slack.ts ฝั่งบอท]
EXPORT_CHANNELS=

# How many days back the export walks. Keep it small while iterating.
# [ไม่ต้องใส่ — default 14]
EXPORT_DAYS=14

# --- the daily thread ---------------------------------------------------------
# One post each morning ("Daily as of 20 August 2026"), answers in its thread, one
# summary in that thread at TAM_DAILY_SUMMARY_AT. Empty DAILY_CHANNEL falls back to
# DIGEST_CHANNEL above, so a team with one channel configures nothing here.
# The channel must also be postable — see SLACK_POST_ALLOWLIST below.
# [ไม่ต้องใส่ — ว่างคือใช้ DIGEST_CHANNEL]
DAILY_CHANNEL=

# When the morning post goes out, HH:MM in TAM_SCHEDULE_TZ. Needs ENABLE_SCHEDULE=1;
# without it nothing fires and you drive it with `/meowtam daily post`.
# [ไม่ต้องใส่ — default 09:00]
TAM_DAILY_AT=

# When the bot re-reads the thread, stores every answer and replies with the summary.
# This is the time the team asked for; the post time above only has to be before it.
# [ไม่ต้องใส่ — default 10:45]
TAM_DAILY_SUMMARY_AT=

# A "Blockers / Pending" line repeated this many dailies running gets one message in
# the channel, tagging whoever it waits on. Counted in dailies, not calendar days, so
# a weekend without a post does not forgive it. Minimum 2 — at 1 every blocker would
# be announced the moment it was first mentioned, which is what the thread is for.
# [ไม่ต้องใส่ — default 3]
TAM_DAILY_PENDING_DAYS=

# Where the daily records live: one entry per day, holding the thread ts and every
# answer as typed. Deleting it loses the "ค้างมา N วัน" counts, nothing else.
# Default: data/dailies.json
# [ไม่ต้องใส่ — default data/dailies.json]
TAM_DAILIES_PATH=

# Comma-separated user IDs that get the standup DM, e.g. U0DEMOUSER1,U0DEMOUSER2
# [ไม่ต้องใส่ — ถ้าไม่ใส่ก็ไม่ส่ง standup DM ให้ใคร]
STANDUP_USERS=

# --- where the bot is allowed to post ----------------------------------------
# A hard allowlist, enforced on the Slack client itself rather than at each of the
# nineteen places that post — so a twentieth added later inherits it too. A
# `chat.postMessage` to anything not listed raises instead of sending.
#
# Empty means DIGEST_CHANNEL plus STANDUP_USERS above, which is the safe default and
# usually what you want. Setting this REPLACES that, so a deliberate widening is
# explicit and visible in one place.
#
# If BOTH are empty the bot may post NOWHERE. That is intended: a misconfigured bot
# should be silent, not loud in somebody else's channel.
#
# Not guarded, deliberately: chat.postEphemeral and views.* — those are visible only to
# the person who just invoked the command and leave nothing behind, and blocking them
# would make a slash command silently do nothing, which reads as a broken bot.
# Comma-separated channel or user ids, e.g. C0DEMOCHAN1,U0DEMOUSER1
# [ไม่ต้องใส่ — ว่างคือใช้ DIGEST_CHANNEL + STANDUP_USERS ซึ่งปลอดภัยกว่า]
SLACK_POST_ALLOWLIST=

# Set to 1 to arm the scheduled digest and drift nudges. Leave empty while
# developing so a stray run does not post into a real channel.
# [ไม่ต้องใส่ — ว่างคือปิดงานตามเวลาทั้งหมด ปลอดภัยโดย default]
ENABLE_SCHEDULE=

# IANA zone the 08:45 / 09:25 schedules run in, e.g. Asia/Bangkok. Empty means the
# host's clock, which moves standup if the server is in another zone.
# [ไม่ต้องใส่ — ว่างคือใช้ timezone ของเครื่อง]
TAM_SCHEDULE_TZ=

# --- reading from the Python pipeline (optional) ------------------------------
# Set this and the bot stops building its own ledger: work items, states,
# evidence, timelines and recall all come from tam.web.server instead, so the
# two halves can no longer disagree about what a work item is. Leave it empty
# and the bot runs exactly as before, offline, against data/ledger.json.
#
#   python3 -m tam.web.server --records data/processed/combined.json --port 8899
#   TAM_API_URL=http://127.0.0.1:8899 npm run check-api
#
# [ไม่ต้องใส่ — แต่ถ้าไม่ใส่ บอทจะใช้ ledger ของตัวเองแทน pipeline]
TAM_API_URL=

# Workspace host used to rebuild Slack permalinks from message ids. Without it
# links go through slack.com, which redirects but shows an interstitial.
# [ไม่ต้องใส่ — ถ้าไม่ใส่ permalink จะผ่าน slack.com แล้ว redirect]
SLACK_WORKSPACE_URL=

# The pipeline has no 'stalled' state. An item it calls active whose last
# activity is older than this many days is rendered as stalled.
# [ไม่ต้องใส่ — default 3]
TAM_STALE_DAYS=3

# One half of the recall gate, not the whole gate.
#
# `/api/search` returns a top-level `relevance: {lexical, dense}` — the raw BM25
# and the raw cosine of the best-matching record, both absolute. Recall reports
# hits only when BOTH hold:
#
#   lexical > 0              the query shares at least one word with the corpus.
#                            Gibberish shares none, so BM25 scores it exactly
#                            0.000. This is the half that catches nonsense.
#   dense >= TAM_MIN_COSINE  the nearest record is also close in meaning, so a
#                            single coincidental shared token is not enough.
#                            This variable is only this half.
#
# Nothing else in the response can answer "did anything match at all". The fused
# `score` is rank-derived: measured on the live corpus, rank 1 of a nonsense query
# scored 0.0328 while rank 1 of a real question scored 0.0297 — the nonsense
# scored *higher*. Every per-hit `why` is min-max normalised inside one result
# set, so `dense` on the top hit reads 1.00 for both. Only these two absolute
# numbers are comparable across queries.
#
# Raising this number does NOT buy back nonsense rejection. Max cosine over N
# documents rises with N for any query, so on a corpus of ~1,000 records
# something always looks similar: across five embedding models a cosine floor
# rejected 0 of 5 nonsense probes, every time. What raising it does do is drop
# genuine questions, which is the damage a user actually notices. Lower it if
# real queries come back empty; 0 leaves the gate lexical-only.
# The nonsense that still passes here is runs of Thai punctuation (ๆ ฯ), which
# occur in ordinary messages, so its lexical match is real. No floor fixes that —
# it is the edge of the mechanism, not a misconfiguration.
#
# The right floor is a property of one corpus and one model together, so measure
# it where it runs instead of trusting this default: `npm run check-api` prints
# bm25 and cos per probe. Tables and reasoning: ../docs/EXPERIMENTS.md (§5).
# A pipeline too old to send `relevance` makes the bot throw rather than pass
# everything — a gate that silently stops gating is what this exists to prevent.
# [ไม่ต้องใส่ — default 0.45]
TAM_MIN_COSINE=0.45

# How long to wait for the pipeline before giving up on a request. There is no
# fallback: while TAM_API_URL is set, the fixture is never substituted. A timeout
# at boot means the bot refuses to start (see hydrate() in src/data.ts), and a
# timeout inside a command means the reply says the pipeline is down. That is
# deliberate — answering from three-day-old fixture data that looks identical to
# live is the one failure nobody would notice in time.
# [ไม่ต้องใส่ — default 20000]
TAM_API_TIMEOUT_MS=20000

# --- how names are shown -----------------------------------------------------
# slack | pseudonym | id — the same three modes and the same meaning as the
# pipeline's TAM_NAMES, because the bot resolves ids itself (src/names.ts) rather
# than printing whatever the server already rendered. Empty picks `slack` when the
# name cache below exists and `pseudonym` when it does not; never raw ids.
#
# Set this to the SAME value as pipeline/.env, or the dashboard and Slack will name
# the same person differently. `pseudonym` also stops the bot posting real Slack
# mentions (<@U0…>), which Slack would otherwise render as the person's real name.
# [ไม่ต้องใส่ — เลือกให้เองตามว่ามี cache ชื่อไหม]
TAM_NAMES=

# The id → name mapping, written by `python3 -m tam.ingest.users --fetch` and
# gitignored. ONE file for both halves: the dashboard and Slack read it, so a name
# is only ever defined in one place.
#   python3 -m tam.ingest.users --fetch                 ดึงชื่อทั้ง workspace (users:read)
#   python3 -m tam.ingest.users --set U0123ABCDE=ชื่อ    คนที่ Slack ไม่คืนมา (ลาออก/guest)
#   python3 -m tam.ingest.users --check --records …      id ที่ยังไม่มีชื่อ (แสดงเป็นชื่อสมมุติ)
# `/meowtam reload` re-reads it, so a fetch while the bot is up needs no restart.
# Default: ../pipeline/data/user_names.json
# [ไม่ต้องใส่ — สองฝั่ง default ตรงกันอยู่แล้ว]
TAM_NAMES_PATH=

# --- what the bot writes itself ----------------------------------------------
# Human corrections to ticket links, in the file the pipeline's linker reads as
# its highest-priority tier. Default: ../pipeline/data/link_overrides.json
# [ไม่ต้องใส่ — สองฝั่ง default ตรงกันอยู่แล้ว]
TAM_OVERRIDES_PATH=

# The decision log the "บันทึกเป็นการตัดสินใจ" shortcut appends to.
# Default: data/decisions.json — empty until someone files one.
# [ไม่ต้องใส่ — default data/decisions.json]
TAM_DECISIONS_PATH=

# Activity inside this many days counts as "what you did" in the standup draft.
# [ไม่ต้องใส่ — default 1.5]
TAM_RECENT_DAYS=1.5

# Drift detection needs a ticket system to compare Slack against, and none is
# connected. Set to 1 to load the fixture's drift for a demo — the rendered
# block then carries a visible "ตัวอย่างจาก fixture" label.
# [ไม่ต้องใส่ — ตั้ง 1 เฉพาะตอนเดโมที่ต้องการตัวอย่าง drift]
DEMO_FIXTURES=

# Whether the room sees "(จำลอง)" on the mornings `/meowtam demo` seeds.
#
# Off by default. The records are still flagged in the file, `demo clear` still
# removes exactly them, and the ephemeral replies the presenter sees still say what
# was seeded — this switch only governs the label on the audience's screen, so a
# demo of a morning can look like a morning.
#
# The cost, since it is not visible from the variable name: with this off, the daily
# summary and the thread post attribute lines to named colleagues who never wrote
# them, and nothing on screen says so. That is fine while a presenter says it out
# loud and stops being fine the moment a screenshot travels without one. Say it out
# loud, and run `/meowtam demo clear` when you are done.
#
# Not covered by this switch, deliberately: "ตัวอย่างจาก fixture" on a drift card.
# That label is not about the data being seeded — it says the comparison against a
# real tracker did not run. Hiding it would claim a feature that did not happen.
# [ไม่ต้องใส่ — ว่างคือไม่โชว์ป้าย · ตั้ง 1 ถ้าอยากให้ป้ายขึ้นตามเดิม]
DEMO_SHOW_SIMULATED=

# --- ticket ------------------------------------------------------------------
# The bot searches YouTrack itself for the "ผูกกับ ticket" picker, so a ticket that
# nobody has typed into Slack yet is still reachable — which is precisely the one
# somebody is reaching for. Two ways to configure it, and the first wins:
#
#   1. these variables → the bot talks to YouTrack directly. Ticket linking then works
#      with no pipeline running, which is the case that matters on demo day.
#   2. leave them empty and set TAM_API_URL + TAM_ADMIN_TOKEN below → the bot goes
#      through the pipeline's own routes, and the token lives in one place.
#
# Same names and same meanings as pipeline/.env, so copying the two lines across is
# all it takes.
# [ไม่ต้องใส่ ถ้าจะให้ยิงผ่าน pipeline แทน]
YOUTRACK_URL=
YOUTRACK_TOKEN=
# Which projects the picker searches when the channel is not mapped below.
# [ไม่ต้องใส่ — ว่างคือค้นทุกโปรเจกต์ที่ token เห็น ซึ่งช้ากว่า]
YOUTRACK_PROJECTS=

# Writing a real comment onto a ticket. OFF by default.
#
# With this off, "ผูกกับ ticket" and the drift screen still do their local work and
# then say — in words, on screen — that no comment was written and which switch is
# off. They never claim a write that did not happen.
# [ไม่ต้องใส่ — ตั้ง 1 เมื่อพร้อมให้บอทเขียนคอมเมนต์ลง ticket จริง]
YOUTRACK_WRITE=
# [ไม่ต้องใส่ — ว่างคือใช้ YOUTRACK_TOKEN เมื่อเปิด YOUTRACK_WRITE แล้ว]
YOUTRACK_WRITE_TOKEN=

# Which channels are which project.
#
#   TAM_CHANNEL_PROJECTS=REVERAPP (Rever App)=C0ABC,#reverapp-qa; MOB=C0GHI
#
# Grouped by project, because "these channels are the same project" is the direction
# the fact runs. Names do not have to match — that #reverapp-dev and #rvr-qa are one
# thing is exactly what nothing can infer from the messages. The bracketed label is
# optional and is what appears on screen; `#name` entries work here (the bot can
# resolve a name) as well as channel ids.
#
# The ticket picker opened from a mapped channel searches only that project, so the
# list is short and right instead of the whole tracker. Set the SAME value in
# pipeline/.env and the linker will also prefer this channel's project when a message
# names two tickets.
# [ไม่ต้องใส่ — ว่างคือค้นทุกโปรเจกต์]
TAM_CHANNEL_PROJECTS=

# Needed for the two things that write through the pipeline: `/meowtam paste`
# (ingesting a chat somebody copied out of a DM) and the reindex that makes a new
# link visible immediately. The server prints this at boot when TAM_ADMIN_TOKEN is
# not set; set it so it survives a restart.
# [ต้องใส่ ถ้าจะใช้ /meowtam paste]
TAM_ADMIN_TOKEN=

# Ingesting a paste re-embeds and re-clusters the corpus, which takes tens of seconds.
# Reusing the read timeout aborted writes that then completed anyway.
# [ไม่ต้องใส่ — default 300000 (5 นาที)]
TAM_API_WRITE_TIMEOUT_MS=

# --- work that went quiet ----------------------------------------------------
# Working days of silence before a work item is raised in DIGEST_CHANNEL. Working
# days, not days: five calendar days across a weekend is three days of silence, which
# is ordinary, and an escalation that cannot tell those apart fires every Monday about
# nothing. Public holidays are not modelled — a calendar the bot cannot verify would
# be a source of confident wrong answers.
# Announced once per item, then again only if it stays quiet another full period.
# [ไม่ต้องใส่ — default 5]
TAM_STALE_WORKDAYS=5

# Where "already announced" is remembered, so a restart does not repeat yesterday's
# escalation. Default: data/announcements.json
# [ไม่ต้องใส่ — default data/announcements.json]
TAM_ANNOUNCEMENTS_PATH=
