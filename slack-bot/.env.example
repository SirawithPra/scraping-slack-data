# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# All three come from https://api.slack.com/apps → your app. Create the app from
# slack-app-manifest.yaml so the scopes match what the code actually calls.

# Bot User OAuth Token, "OAuth & Permissions" page. Starts xoxb-
# [ต้องใส่ — บอทเริ่มไม่ได้ถ้าไม่มี]
SLACK_BOT_TOKEN=

# App-Level Token with connections:write, "Basic Information" → App-Level Tokens.
# Starts xapp-. Socket Mode needs this; without it the app cannot open a socket.
# [ต้องใส่ — Socket Mode เปิดไม่ได้ถ้าไม่มี]
SLACK_APP_TOKEN=

# "Basic Information" → App Credentials → Signing Secret.
# [ต้องใส่ — บอทเริ่มไม่ได้ถ้าไม่มี]
SLACK_SIGNING_SECRET=

# Where the daily digest is posted. Channel ID, not name — the bot must be a
# member. Find it under View channel details → About, e.g. C0DEMOCHAN1
# [ไม่ต้องใส่ — แต่ถ้าไม่ใส่ digest ตามเวลาจะไม่โพสต์ที่ไหน และ allowlist จะแคบลง]
DIGEST_CHANNEL=

# Comma-separated channel IDs for scripts/export-slack.ts, e.g. C0DEMOCHAN1,C0ABC123
# [ไม่ต้องใส่ — ใช้เฉพาะ scripts/export-slack.ts ฝั่งบอท]
EXPORT_CHANNELS=

# How many days back the export walks. Keep it small while iterating.
# [ไม่ต้องใส่ — default 14]
EXPORT_DAYS=14

# Comma-separated user IDs that get the standup DM, e.g. U0DEMOUSER1,U0DEMOUSER2
# [ไม่ต้องใส่ — ถ้าไม่ใส่ก็ไม่ส่ง standup DM ให้ใคร]
STANDUP_USERS=

# --- where the bot is allowed to post ----------------------------------------
# A hard allowlist, enforced on the Slack client itself rather than at each of the
# nineteen places that post — so a twentieth added later inherits it too. A
# `chat.postMessage` to anything not listed raises instead of sending.
#
# Empty means DIGEST_CHANNEL plus STANDUP_USERS above, which is the safe default and
# usually what you want. Setting this REPLACES that, so a deliberate widening is
# explicit and visible in one place.
#
# If BOTH are empty the bot may post NOWHERE. That is intended: a misconfigured bot
# should be silent, not loud in somebody else's channel.
#
# Not guarded, deliberately: chat.postEphemeral and views.* — those are visible only to
# the person who just invoked the command and leave nothing behind, and blocking them
# would make a slash command silently do nothing, which reads as a broken bot.
# Comma-separated channel or user ids, e.g. C0DEMOCHAN1,U0DEMOUSER1
# [ไม่ต้องใส่ — ว่างคือใช้ DIGEST_CHANNEL + STANDUP_USERS ซึ่งปลอดภัยกว่า]
SLACK_POST_ALLOWLIST=

# Set to 1 to arm the scheduled digest and drift nudges. Leave empty while
# developing so a stray run does not post into a real channel.
# [ไม่ต้องใส่ — ว่างคือปิดงานตามเวลาทั้งหมด ปลอดภัยโดย default]
ENABLE_SCHEDULE=

# IANA zone the 08:45 / 09:25 schedules run in, e.g. Asia/Bangkok. Empty means the
# host's clock, which moves standup if the server is in another zone.
# [ไม่ต้องใส่ — ว่างคือใช้ timezone ของเครื่อง]
TAM_SCHEDULE_TZ=

# --- reading from the Python pipeline (optional) ------------------------------
# Set this and the bot stops building its own ledger: work items, states,
# evidence, timelines and recall all come from tam.web.server instead, so the
# two halves can no longer disagree about what a work item is. Leave it empty
# and the bot runs exactly as before, offline, against data/ledger.json.
#
#   python3 -m tam.web.server --records data/processed/combined.json --port 8899
#   TAM_API_URL=http://127.0.0.1:8899 npm run check-api
#
# [ไม่ต้องใส่ — แต่ถ้าไม่ใส่ บอทจะใช้ ledger ของตัวเองแทน pipeline]
TAM_API_URL=

# Workspace host used to rebuild Slack permalinks from message ids. Without it
# links go through slack.com, which redirects but shows an interstitial.
# [ไม่ต้องใส่ — ถ้าไม่ใส่ permalink จะผ่าน slack.com แล้ว redirect]
SLACK_WORKSPACE_URL=

# The pipeline has no 'stalled' state. An item it calls active whose last
# activity is older than this many days is rendered as stalled.
# [ไม่ต้องใส่ — default 3]
TAM_STALE_DAYS=3

# One half of the recall gate, not the whole gate.
#
# `/api/search` returns a top-level `relevance: {lexical, dense}` — the raw BM25
# and the raw cosine of the best-matching record, both absolute. Recall reports
# hits only when BOTH hold:
#
#   lexical > 0              the query shares at least one word with the corpus.
#                            Gibberish shares none, so BM25 scores it exactly
#                            0.000. This is the half that catches nonsense.
#   dense >= TAM_MIN_COSINE  the nearest record is also close in meaning, so a
#                            single coincidental shared token is not enough.
#                            This variable is only this half.
#
# Nothing else in the response can answer "did anything match at all". The fused
# `score` is rank-derived: measured on the live corpus, rank 1 of a nonsense query
# scored 0.0328 while rank 1 of a real question scored 0.0297 — the nonsense
# scored *higher*. Every per-hit `why` is min-max normalised inside one result
# set, so `dense` on the top hit reads 1.00 for both. Only these two absolute
# numbers are comparable across queries.
#
# Raising this number does NOT buy back nonsense rejection. Max cosine over N
# documents rises with N for any query, so on a corpus of ~1,000 records
# something always looks similar: across five embedding models a cosine floor
# rejected 0 of 5 nonsense probes, every time. What raising it does do is drop
# genuine questions, which is the damage a user actually notices. Lower it if
# real queries come back empty; 0 leaves the gate lexical-only.
# The nonsense that still passes here is runs of Thai punctuation (ๆ ฯ), which
# occur in ordinary messages, so its lexical match is real. No floor fixes that —
# it is the edge of the mechanism, not a misconfiguration.
#
# The right floor is a property of one corpus and one model together, so measure
# it where it runs instead of trusting this default: `npm run check-api` prints
# bm25 and cos per probe. Tables and reasoning: ../docs/EXPERIMENTS.md (§5).
# A pipeline too old to send `relevance` makes the bot throw rather than pass
# everything — a gate that silently stops gating is what this exists to prevent.
# [ไม่ต้องใส่ — default 0.45]
TAM_MIN_COSINE=0.45

# How long to wait for the pipeline before giving up on a request. There is no
# fallback: while TAM_API_URL is set, the fixture is never substituted. A timeout
# at boot means the bot refuses to start (see hydrate() in src/data.ts), and a
# timeout inside a command means the reply says the pipeline is down. That is
# deliberate — answering from three-day-old fixture data that looks identical to
# live is the one failure nobody would notice in time.
# [ไม่ต้องใส่ — default 20000]
TAM_API_TIMEOUT_MS=20000

# --- what the bot writes itself ----------------------------------------------
# Human corrections to ticket links, in the file the pipeline's linker reads as
# its highest-priority tier. Default: ../pipeline/data/link_overrides.json
# [ไม่ต้องใส่ — สองฝั่ง default ตรงกันอยู่แล้ว]
TAM_OVERRIDES_PATH=

# The decision log the "บันทึกเป็นการตัดสินใจ" shortcut appends to.
# Default: data/decisions.json — empty until someone files one.
# [ไม่ต้องใส่ — default data/decisions.json]
TAM_DECISIONS_PATH=

# Activity inside this many days counts as "what you did" in the standup draft.
# [ไม่ต้องใส่ — default 1.5]
TAM_RECENT_DAYS=1.5

# Drift detection needs a ticket system to compare Slack against, and none is
# connected. Set to 1 to load the fixture's drift for a demo — the rendered
# block then carries a visible "ตัวอย่างจาก fixture" label.
# [ไม่ต้องใส่ — ตั้ง 1 เฉพาะตอนเดโมที่ต้องการตัวอย่าง drift]
DEMO_FIXTURES=
