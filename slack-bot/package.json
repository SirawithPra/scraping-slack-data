{
  "name": "meowtam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meowtam — a Slack-native work ledger. Hackathon build.",
  "scripts": {
    "seed": "node -e \"const{copyFileSync,existsSync}=require('node:fs');const t='data/ledger.json';if(existsSync(t)){process.exit(0)}copyFileSync('data/ledger.fixture.json',t);console.log('✓ seeded '+t+' from data/ledger.fixture.json')\"",
    "predev": "npm run seed",
    "dev": "tsx watch src/app.ts",
    "prestart": "npm run seed",
    "start": "tsx src/app.ts",
    "typecheck": "tsc --noEmit",
    "export": "tsx scripts/export-slack.ts",
    "ledger": "tsx scripts/build-ledger.ts",
    "prepreview": "npm run seed",
    "preview": "tsx scripts/preview.ts",
    "check-api": "tsx scripts/check-api.ts",
    "pretest": "npm run seed",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.1",
    "@slack/types": "^2.22.0",
    "@slack/web-api": "^7.8.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
