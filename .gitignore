# --- secrets -----------------------------------------------------------------
# `.env` with no slash matches at every depth, so this covers pipeline/,
# slack-bot/, and anything added later. Only *.example files are tracked.
.env
*.env
!.env.example
!**/.env.example

# --- python ------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]

# --- node --------------------------------------------------------------------
node_modules/

# --- os ----------------------------------------------------------------------
.DS_Store

# --- private data ------------------------------------------------------------
# Real Slack exports and everything derived from them. The pipeline can rebuild
# all of it; none of it belongs in a public repo. The sample directories are the
# exception: they are committed on purpose so both halves run with no Slack
# access at all.
#
# Whole directories rather than an extension list, because extension and depth
# both used to matter and neither should: the docs tell you to drop .vtt/.srt
# transcripts into raw/ (tam.ingest.meetings:25), and a Slack admin export unzips
# into per-channel *subdirectories* of dated .json — `raw/*.json` reached neither.
# Display names read from Slack (python3 -m tam.ingest.users --fetch). Real people's
# names are personal data and this repo is public; the ids in the corpus are enough to
# rebuild this file, and TAM_NAMES=pseudonym renders without it at all.
pipeline/data/user_names.json*

pipeline/data/raw/**
pipeline/data/processed/**
pipeline/data/eval_queries*.json
pipeline/output/*
slack-bot/data/raw-slack.json
*_export.json
!.gitkeep
!pipeline/data/sample/*.json
!pipeline/data/eval_queries.example.json

# --- large artefacts ---------------------------------------------------------
# Fine-tuned weights run ~465MB, over GitHub's 100MB file limit.
# Rebuild with: cd pipeline && python3 -m tam.evaluation.finetune
pipeline/models/
models/

# --- internal documents ------------------------------------------------------
# Business proposal naming a real client contact. Never publish.
tam-proposal.md

# Human ticket-link corrections written by the bot. Real record ids from a real
# workspace, and rebuildable only by the people who made them — keep local.
# The trailing * covers the `.bak` store.ts keeps and the `.tmp` it renames from:
# same contents, same workspace, and neither was covered before.
pipeline/data/link_overrides.json*
slack-bot/data/decisions.json*

# `npm run ledger` writes data/ledger.json from a real Slack export — verbatim
# message text, user ids, channel names and permalinks. It used to be a *tracked*
# file, so the documented workflow left real content staged in a public repo and
# one `git commit -a` from publication. The generated file is now never the
# tracked one: `data/ledger.fixture.json` is the committed demo ledger, and
# `npm run seed` copies it here when the file is absent so the offline demo still
# works on a fresh clone.
slack-bot/data/ledger.json*
