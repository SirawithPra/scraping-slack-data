# --- secrets -----------------------------------------------------------------
# `.env` with no slash matches at every depth, so this covers pipeline/,
# slack-bot/, and anything added later. Only *.example files are tracked.
.env
*.env
!.env.example
!**/.env.example

# --- python ------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]

# --- node --------------------------------------------------------------------
node_modules/

# --- os ----------------------------------------------------------------------
.DS_Store

# --- private data ------------------------------------------------------------
# Real Slack exports and everything derived from them. The pipeline can rebuild
# all of it; none of it belongs in a public repo. The sample directories are the
# exception: they are committed on purpose so both halves run with no Slack
# access at all.
pipeline/data/raw/*.json
pipeline/data/processed/*.json
pipeline/data/processed/*.npz
pipeline/data/eval_queries*.json
pipeline/output/*
slack-bot/data/raw-slack.json
*_export.json
!.gitkeep
!pipeline/data/sample/*.json
!pipeline/data/eval_queries.example.json

# --- large artefacts ---------------------------------------------------------
# Fine-tuned weights run ~450MB, over GitHub's 100MB file limit.
# Rebuild with: cd pipeline && python3 -m tam.evaluation.finetune
pipeline/models/
models/

# --- internal documents ------------------------------------------------------
# Business proposal naming a real client contact. Never publish.
tam-proposal.md

# Human ticket-link corrections written by the bot. Real record ids from a real
# workspace, and rebuildable only by the people who made them — keep local.
pipeline/data/link_overrides.json
slack-bot/data/decisions.json
