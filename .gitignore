# --- secrets -----------------------------------------------------------------
# `.env` with no slash matches at every depth, so this one line covers the repo
# root, apps/meowtam/, and anything added later. Only *.example files are tracked.
.env
*.env
!.env.example
!**/.env.example

# --- python ------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]

# --- node --------------------------------------------------------------------
node_modules/

# --- os ----------------------------------------------------------------------
.DS_Store

# --- private data ------------------------------------------------------------
# Real Slack exports and everything derived from them. The pipeline can rebuild
# all of it; none of it belongs in a public repo. data/sample/ is the exception:
# it is committed on purpose so the repo runs with no Slack access at all.
data/raw/*.json
data/processed/*.json
data/processed/*.npz
data/eval_queries*.json
apps/meowtam/data/raw-slack.json
output/*
*_export.json
!.gitkeep
!data/sample/*.json
!data/eval_queries.example.json

# --- large artefacts ---------------------------------------------------------
# Fine-tuned weights run ~450MB, over GitHub's 100MB file limit.
# Rebuild with: python3 -m tam.evaluation.finetune
models/

# --- internal documents ------------------------------------------------------
# Business proposal naming a real client contact. Never publish.
tam-proposal.md
