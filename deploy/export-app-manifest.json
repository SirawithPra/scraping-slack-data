{
  "display_information": {
    "name": "Semantic Search PoC",
    "description": "Read-only export of channel history for a semantic search proof of concept."
  },
  "features": {
    "bot_user": {
      "display_name": "Semantic Search PoC",
      "always_online": false
    }
  },
  "oauth_config": {
