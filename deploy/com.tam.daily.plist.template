<?xml version="1.0" encoding="UTF-8"?>
<!--
  The refresh: export every channel incrementally, merge tickets and messages, rebuild.

  The schedule is substituted by install.sh, because this job has two honest cadences.
  The default is StartCalendarInterval at 08:30 rather than an interval timer: it should
  happen once before standup, and launchd runs a calendar job that was missed while the
  machine slept as soon as it wakes — the normal case for a laptop at that hour.

      ./install.sh                                  # 08:30 daily, the standing setup
      TAM_DAILY_EVERY=600 ./install.sh com.tam.daily  # every 10 min, for testing a loop

  The second form exists because a demo cannot wait until tomorrow morning to find out
  whether a message typed in Slack reaches the dashboard.

  No KeepAlive: it is a job that finishes. Its exit code lands in `launchctl list`, so a
  failed run is visible without reading the log.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tam.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VENV__/bin/python</string>
    <string>-m</string><string>tam.ingest.daily</string>
    <string>--records</string><string>__RECORDS__</string>
  </array>
  <key>WorkingDirectory</key><string>__PIPELINE__</string>
  __SCHEDULE__
  <key>StandardOutPath</key><string>__LOGS__/daily.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/daily.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>HF_HUB_OFFLINE</key><string>1</string>
  </dict>
</dict>
</plist>
