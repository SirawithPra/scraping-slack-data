# Copy to .env and fill in. Never commit .env or a real token.

# Bot token (xoxb-...) or user token (xoxp-...) with channels:history / groups:history
SLACK_TOKEN=

# Channel to export, e.g. C0123ABCDEF (Slack > channel > About > Channel ID)
SLACK_CHANNEL_ID=

# Cap on parent messages fetched per run. Start small for the PoC.
SLACK_MAX_MESSAGES=200

# Optional. Ticket prefixes that tam.analysis.linker may treat as a work item's identity,
# e.g. ACME,ACM. Without this the corpus is the evidence: a prefix seen with
# several different numbers is a project, one that is always the same string is a
# standard (UTF-8). Setting it is still better — being told beats guessing, and a
# wrong ticket key does not just rank badly, it invents a work item.
TICKET_PROJECTS=

# Optional — leave empty to use the measured default, BAAI/bge-m3.
# It was chosen on a real 1,102-record Thai/English corpus: 63.7% triplet accuracy
# on held-out threads, the lowest nonsense-query cosine of seven models compared,
# and 8192-token context where the old default's 128 truncated 13.4% of records.
# Alternatives, with the numbers behind them, in docs/EXPERIMENTS.md:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   fastest, weakest
#   sentence-transformers/paraphrase-multilingual-mpnet-base-v2   close, worse gate
#   intfloat/multilingual-e5-base   (query:/passage: prefixes are added for you)
# Every script also takes --model, which wins over this for one run.
# Switching models invalidates nothing: each one gets its own embedding cache file.
EMBEDDING_MODEL=

# Optional. Cross-encoder used by tam.retrieval.rerank. It only loads when a run
# actually asks for reranking, so leaving this set costs nothing until then.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional. Once the models are downloaded, this skips all Hugging Face network
# checks: ~12s -> ~4s per run, and switching models stays fast offline.
# Comment it out when you want to pull a model you do not have yet.
HF_HUB_OFFLINE=1

# Who writes the digest prose. 'template' (default) formats the facts digest.py
# computed and sends nothing anywhere; 'claude' calls the Anthropic API, which
# means your Slack text leaves this machine.
SUMMARIZER=template

# Only read when SUMMARIZER=claude.
SUMMARIZER_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Optional, also only read when SUMMARIZER=claude. Output ceiling for one digest.
# A wide --days window is what runs into it; raising this costs tokens, narrowing
# the window costs nothing.
SUMMARIZER_MAX_TOKENS=32000

# Optional. Where the embedding caches live. The default is anchored to the
# package, not to the process, so a service started from another directory still
# hits the same cache instead of silently building an empty second one.
# TAM_CACHE_DIR=

# Optional. Fixes the token every write route on the dashboard demands
# (POST /api/reindex, POST /upload) instead of generating a new one per start.
# Required by --expose, which refuses to bind a non-loopback address without it.
# TAM_ADMIN_TOKEN=
