# Copy to .env and fill in. Never commit .env or a real token.

# Bot token (xoxb-...) or user token (xoxp-...) with channels:history / groups:history
# [ต้องใส่ ถ้าจะดึงข้อมูลจริงจาก Slack]
SLACK_TOKEN=

# Channel to export, e.g. C0123ABCDEF (Slack > channel > About > Channel ID)
# [ไม่ต้องใส่ ถ้าใช้ --all-channels]
SLACK_CHANNEL_ID=

# Cap on parent messages fetched per run. Start small for the PoC.
# [ไม่ต้องใส่ — default 200]
SLACK_MAX_MESSAGES=200

# Optional. Ticket prefixes that tam.analysis.linker may treat as a work item's identity,
# e.g. ACME,ACM. Without this the corpus is the evidence: a prefix seen with
# several different numbers is a project, one that is always the same string is a
# standard (UTF-8). Setting it is still better — being told beats guessing, and a
# wrong ticket key does not just rank badly, it invents a work item.
# [ไม่ต้องใส่ — เดาจาก corpus เอง]
TICKET_PROJECTS=

# Optional — leave empty to use the measured default, BAAI/bge-m3.
# It was chosen on a real 1,102-record Thai/English corpus: 63.7% triplet accuracy
# on held-out threads, the lowest nonsense-query cosine of seven models compared,
# and 8192-token context where the old default's 128 truncated 13.4% of records.
# Alternatives, with the numbers behind them, in docs/EXPERIMENTS.md:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   fastest, weakest
#   sentence-transformers/paraphrase-multilingual-mpnet-base-v2   close, worse gate
#   intfloat/multilingual-e5-base   (query:/passage: prefixes are added for you)
# Every script also takes --model, which wins over this for one run.
# Switching models invalidates nothing: each one gets its own embedding cache file.
# [ไม่ต้องใส่ — default BAAI/bge-m3]
EMBEDDING_MODEL=

# Optional. Cross-encoder used by tam.retrieval.rerank. It only loads when a run
# actually asks for reranking, so leaving this set costs nothing until then.
# [ไม่ต้องใส่ — ใช้เมื่อเลือก preset ที่มี rerank]
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional, and OFF by default on purpose. Once the models are cached locally this
# skips every Hugging Face network check, which measurably shortens each run. But a
# fresh clone has nothing cached, and with this set the first run cannot download the
# model — it fails with "We couldn't connect" while the machine is plainly online,
# which is a miserable first five minutes. Uncomment it after the first successful run.
# [ไม่ต้องใส่ — และห้ามใส่ตอนรันครั้งแรก]
HF_HUB_OFFLINE=

# Who writes the digest prose. 'template' (default) formats the facts digest.py
# computed and sends nothing anywhere; 'claude' calls the Anthropic API, which
# means your Slack text leaves this machine.
# [ไม่ต้องใส่ — default template ทำงานออฟไลน์]
SUMMARIZER=template

# Only read when SUMMARIZER=claude.
# [ไม่ต้องใส่ — ใช้เมื่อ SUMMARIZER=claude]
SUMMARIZER_MODEL=claude-opus-5
# [ต้องใส่ เฉพาะเมื่อ SUMMARIZER=claude]
ANTHROPIC_API_KEY=

# Optional, also only read when SUMMARIZER=claude. Output ceiling for one digest.
# A wide --days window is what runs into it; raising this costs tokens, narrowing
# the window costs nothing.
# [ไม่ต้องใส่ — default 32000]
SUMMARIZER_MAX_TOKENS=32000

# Optional. Where the embedding caches live. The default is anchored to the
# package, not to the process, so a service started from another directory still
# hits the same cache instead of silently building an empty second one.
# [ไม่ต้องใส่ — default data/processed/]
TAM_CACHE_DIR=

# Optional. Fixes the token every write route on the dashboard demands
# (POST /api/reindex, POST /upload) instead of generating a new one per start.
# Required by --expose, which refuses to bind a non-loopback address without it.
# [ต้องใส่ ถ้าจะให้ tam.ingest.daily สั่ง rebuild เอง หรือใช้ --expose]
TAM_ADMIN_TOKEN=

# --- how names are shown -----------------------------------------------------
# slack | pseudonym | id. Empty picks `slack` when data/user_names.json exists and
# `pseudonym` when it does not — never raw ids, because an eleven-character key is
# unreadable in the one moment the digest is supposed to help.
# Populate the cache once with: python3 -m tam.ingest.users --fetch  (needs users:read)
#   pseudonym  stable invented names, same person always the same name. Use it for a
#              demo or a screenshot — but note it hides only the *author*, not customer
#              data somebody typed into a message. Check with your eyes before sharing.
#   id         raw ids, for debugging whether a join is correct.
# The Slack bot reads the same data/user_names.json and honours the same three
# modes, so set slack-bot/.env to the same value — otherwise the dashboard and
# Slack name the same person differently, which is worse than either alone.
#   python3 -m tam.ingest.users --set U0123ABCDE=ชื่อ    somebody users.list omits
#   python3 -m tam.ingest.users --check --records …      ids with no name yet
# [ไม่ต้องใส่ — เลือกให้เองตามว่ามี cache ชื่อไหม]
TAM_NAMES=

# --- where human corrections live --------------------------------------------
# The file the Slack bot writes when somebody re-links a message to the right work
# item, and the linker reads as its highest-priority tier. Both halves default to the
# same path, so neither needs configuring for them to agree.
# Default: data/link_overrides.json  (gitignored — it holds real record ids)
# [ไม่ต้องใส่ — สองฝั่ง default ตรงกันอยู่แล้ว]
TAM_OVERRIDES_PATH=

# --- the dashboard the daily refresh rebuilds --------------------------------
# Only used by `python3 -m tam.ingest.daily` to POST /api/reindex when it finishes.
# It needs TAM_ADMIN_TOKEN above to be set, or it reports that it skipped the rebuild.
# Default: http://127.0.0.1:8899
# [ไม่ต้องใส่ — default http://127.0.0.1:8899]
TAM_API_URL=

# --- YouTrack (optional, for drift detection) --------------------------------
# Drift detection is the one thing connecting a chat model to Slack cannot do: compare
# what Slack says about a work item against what its ticket says, and report the
# disagreement. Without these the feature is empty rather than faked — the bot renders
# no drifts and says on screen that no ticket system is connected.
#
# READ-ONLY IS ENOUGH. Nothing here writes to YouTrack. Create a dedicated service
# account rather than using a personal token, and give it only Read Issue plus Read
# Issue Comment on the projects you care about: a token that can write, in a system
# that never writes, is risk with no benefit.
#   YouTrack → Users → New user → open it → Account Security → New token
#   Scope: YouTrack only.
# [ต้องใส่ ถ้าจะใช้ drift detection]
YOUTRACK_URL=
# [ต้องใส่ ถ้าจะใช้ drift detection — อ่านอย่างเดียวพอ]
YOUTRACK_TOKEN=
# Comma-separated project short names to read, e.g. PROJ,MOB. Empty reads every project
# the token can see, which is slower and usually more than you meant.
# [ไม่ต้องใส่ — ว่างคืออ่านทุกโปรเจกต์ที่ token เห็น]
YOUTRACK_PROJECTS=

# Writing a comment onto a ticket. OFF by default, and deliberately two switches.
#
# A comment is visible to the whole team and cannot be taken back quietly, so "may this
# deployment write at all" is a decision somebody makes once (this variable) and "with
# whose permissions" is a token (the next one). Keeping them apart is what lets
# YOUTRACK_TOKEN above stay read-only: turning writing on with one variable would hand
# write access to every read in the codebase.
#
# Off means the Slack bot's "ผูกกับ ticket" and drift screens still work — they save the
# link on our side and say, in words, that the comment was not written and why.
# [ไม่ต้องใส่ — ว่างคือไม่เขียนอะไรลง YouTrack เลย]
YOUTRACK_WRITE=
# A token that may comment. Falls back to YOUTRACK_TOKEN when empty, but only once
# YOUTRACK_WRITE is on.
# [ไม่ต้องใส่ — ว่างคือใช้ YOUTRACK_TOKEN เมื่อเปิด YOUTRACK_WRITE แล้ว]
YOUTRACK_WRITE_TOKEN=

# Which channels are which project. The one structural fact nothing can infer.
#
#   TAM_CHANNEL_PROJECTS=REVERAPP (Rever App)=C0ABC,C0DEF; MOB=C0GHI
#
# Grouped by project, because that is the direction the fact runs: "these channels are
# the same project". Several channels can map to one project and their names do not have
# to match — #reverapp-dev and #rvr-qa being one thing is exactly what no amount of
# reading messages recovers. The name in brackets is optional and is what the UI prints.
# A `#name` entry works too, but only the Slack bot can resolve one; the pipeline matches
# channel ids, because that is what a record carries.
#
# What it buys: the linker prefers this channel's own project when a message names two
# tickets ("MOB-12 รอ REV-1421 ก่อน" is about MOB-12, but REV wins on frequency), and
# the bot's ticket picker opens on this project instead of the whole tracker.
# The same variable is read by slack-bot/.env — same name, same syntax, on purpose.
# [ไม่ต้องใส่ — ว่างคือเดาจาก corpus เหมือนเดิม]
TAM_CHANNEL_PROJECTS=

# [ไม่ต้องใส่ — แต่ควรใส่ถ้าบอทโพสต์ลงช่องที่ตัวเองอ่าน]
# Slack user id ของบอทเอง เพื่อไม่ให้ข้อความที่มันโพสต์ไหลกลับเข้า corpus ที่มันอ่าน
# ข้อความ digest มีชื่องานกับข้อความหลักฐานอยู่ในนั้น ถ้าไม่กรอง มันจะไปจับกลุ่มกับงานที่
# ตัวเองบรรยาย แล้วเสริมตัวเองทุกรอบ — วัดแล้วว่าทำให้เกิด drift ปลอมขึ้นมาหนึ่งอัน
# หาได้จาก auth.test บน bot token · exporter พิมพ์ไว้ในบรรทัด "Authenticated as …"
TAM_SELF_USER=

# ช่องที่มีไว้ลองบอท ไม่ใช่งาน — คอมมาคั่น เอา channel id ไม่ใช่ชื่อ
# #meow-meow กับ #meowtamm บนเวิร์กสเปซนี้มีแต่การลอง slash command, ร่างสไลด์พิตช์
# และเถียงกันเรื่องไอติม การจับกลุ่มแยกไม่ออก จึงอ่านร่างพิตช์เป็นงานหนึ่งชิ้นและรายงานว่า
# resolved ส่วน "ยังกินติมอยุ่เลย" ไปโผล่เป็นหลักฐานในงานที่ blocked จริง
# บอทยังอ่านและตอบในช่องนี้ได้ตามปกติ — แค่การวิเคราะห์ไม่นับ
TAM_SKIP_CHANNELS=
